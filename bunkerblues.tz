// This is special and sets the release number in the header (and is available as the constant as well)
constant ReleaseNumber = 1;

object Player "Player" in Airlock {
}

#include "core.tzh"

property object general;

global PuzzleState;
constant ELECTRICITY_STATUS = 1 << 0;
constant HELMET_FREE = 1 << 1;
constant CHARCOAL_IN_FILTER = 1 << 2;
constant FILTER_IN_HELMET = 1 << 3;

object survival_suit in Player {
	adjective: 'survival';
	noun: 'suit';
	description: "A heavy-duty survival suit, slightly too large and smelling of must. It offers some protection but leaves your head entirely exposed.";
	clothing; worn;
	before: [act obj] {
		if (act in {#unwear,#drop})
			print_ret "You're afraid that if you try to take it off, you won't be able to get it back on again.";
		rfalse;
	}
}

location Airlock {
	description: "You are standing in a dimly lit airlock of a 
		fallout shelter. You hear the faint hum of the emergency 
		light, and an acrid smell from the fire you escaped lingers 
		in the air.^^As you look around the otherwise sterile room, 
		you notice a small control panel on the wall to your left, 
		next to the internal door.";
	s_to: [] { return DoorHelper(internal_door,MainCorridor); }
	pobjects: internal_door;
	lit;
}

contains
object emergency_pack {
	noun: 'pack' 'backpack' 'bag' 'sack';
	adjective: 'emergency';
	description: "A battered canvas emergency pack with worn straps. Wearing it across your back gives you considerably more carrying capacity.";
	clothing;
	container;
	transparent;
}

and
object panel {
	noun: 'panel' 'board' 'wire';
	adjective: 'control' 'circuit';
	scenery;
	openable;
	description: [self] {
		if (self has open) {
			if (internal_door has open)
				print_ret "The panel is open. A paperclip is now permanently fused to the circuit board, providing power to the inner door.";
			else
				print_ret "The panel is open. A wire on the circuit board has burnt out, stopping the door from working.";
		}
		else
			print_ret "A small control panel on the wall next to the internal door. It is closed.";
	}
	before: [self act obj] {
		if (act is #puton) {
			rtrue if not obj;
			if (self hasn't open)
				print_ret "You'll need to open the panel first.";
		}
		rfalse;
	}
	after: [self act obj] {
		// print_obj obj; crlf;
		if (act is #receive and obj is paperclip) {
			internal_door gains open;
			unparent paperclip;
			return ScoreMsg(3,"The paperclip shorts out the broken wire and the door slides slowly open on the dwindling emergency power.");
		}
		rfalse;
	}
}


object papers in emergency_pack {
	noun: 'paper' 'papers';
	description: [self] {
		self.description = [] { print_ret "It's instructions on how to survive the apocalypse"; };
		move paperclip into room;
		print_ret "As you look at the papers, the paperclip holding them together falls to the floor.";
	}
	plural;
}

object internal_door { // This exists in both the Airlock and the MainCorridor.
	noun: 'door';
	description: "The internal door is made out of metal.";
	openable;
	before: [act obj] {
		if (act is #open)
			print_ret "You'll need to find some other way to do that, try examining the panel.";
		rfalse;
	}
}

object paperclip in Limbo  {
	description: "The pinnacle of modern stationery, it holds small piles of papers together.";
	noun: 'paperclip' 'clip';
	adjective: 'paper';
}

location Canteen {
	description: "Rows of moulded plastic chairs sit askew around bolted-down tables, their surfaces sticky with the residue of years of institutional meals. A serving hatch at the far end stands open, the kitchen beyond cold and still.";
	e_to: MainCorridor;
	s_to: Kitchen;
	lit;
}

contains
object coffee_maker {
	noun: 'maker';
	adjective: 'coffee';
	description: [self] {
		move coffee_filter into room;
		self.description = [] { print_ret "It's just an ordinary coffee maker, with nothing inside it."; };
		print_ret "It's just an ordinary coffee maker-- hey, wait, a coffee filter just fell out of it.";
	}
	static;
}

object coffee_filter in Limbo {
	noun: 'filter';
	adjective: 'coffee';
}

global TibblesBanter = word_array(6) {
	"~I'm a cleaner, not a magician, but watch this dirt disappear!~",
	"~Why walk when you can vacuum?~",
    "~Clean floors, happy life.~",
    "~I've got the suction, and I'm not afraid to use it.~",
    "~I'm not just a pretty face, I'm a pretty powerful vacuum too!~",
	"~Dirt, dust, and debris beware, I'm on the prowl!~"
};

location MainCorridor {
	description: [self] {
		if (random(4) is 1)
			print "Tibbles: ", paddr TibblesBanter[[random(6)-1]], crlf;
		if (PuzzleState &= ELECTRICITY_STATUS)
			print_ret "The main corridor runs the full length of the bunker under steady, bright fluorescent 
				light - a relief after the emergency flicker. Rows of painted-steel doors line each side, 
				their stencilled numbers sharp and clear.";
		else
			print_ret "Fluorescent strips flicker overhead, casting a 
				sickly pallor over the metal-lined corridor running 
				the full length of the bunker. Rows of identical 
				painted-steel doors line each side, their stencilled 
				numbers faded to near-illegibility.";
	}
	n_to: [] { return DoorHelper(internal_door,Airlock); }
	s_to: WECorridor;
	sw_to: Lounge;
	se_to: Gymnasium;
	w_to: Canteen;
	e_to: BunkRoom;
	lit;
	pobjects: internal_door;
}

contains
object light_stick  {
	description: [self] {
		if (self hasn't lit)
			print_ret "It's a light stick. You can shake it to make it give off light.";
		else {
			print "It's a light stick, currently giving off ";
			if (self.general > 100)
				print_ret "quite a surprising bit of light.";
			else if (self.general > 30)
				print_ret "a good amount of light.";
			else
				print_ret "a rather feeble amount of light.";
		}
	}
	noun: 'stick' 'lightstick';
	adjective: 'light';
	after: [self act] {
		if (act is #shake) {
			if (self has lit)
				print_ret "It's already lit!";
			else {
				self gains lit;
				self.general = 150;
				print_ret "It starts giving off a faint light.";
			}
		}
		rfalse;
	}
	general: 0;
}

routine ShakeSub[do] {
	if (Player holds do) {
		if (isfalse CallAfter(#shake,do)) 
			print_ret "Shaking that is pointless."; 
	}
	else
		print_ret "You need to pick it up first.";
	 rfalse; 
}

action #shake { 'shake' Nearby: ShakeSub }

location BunkRoom {
	w_to: MainCorridor;
	e_to: Closet;
	s_to: Latrine;
	lit;
}

location Closet {
	w_to: BunkRoom;
}

contains object jacket {
	noun: 'jacket';
	description: [self] {
		self.description = [] { print_ret "It is Bob's jacket. You miss Bob."; };
		move code_book into room;
		print_ret "As you look inside the jacket a small booklet falls from one of the pockets.";
	}
	before: [self act obj] {
		if (act==#wear)
			print_ret "It won't fit properly over your survival suit.";
		rfalse;
	}
}
 
object code_book {
	noun: 'codebook' 'book' 'booklet';
	adjective: 'code';
	description: "A small, well-thumbed notebook containing radio signal codes and door access codes, written in a cramped but legible hand.";
}

location Storeroom {
	description: "The storeroom.";
	e_to: Kitchen;
	s_to: Hydroponic;
}

contains
object crowbar {
	noun: 'crowbar';
}

location Kitchen {
	w_to: Storeroom;
	n_to: Canteen;
	s_to: Pantry;
}

contains
object bread_knife {
	noun: 'knife';
	adjective: 'bread';
}

location Latrine {
	description: "A row of lidded steel lavatories and a pair of cracked porcelain sinks occupy this narrow utility room. A persistent drip somewhere keeps time in the silence, and the overhead strip light hums with the effort of staying on.";
	n_to: BunkRoom;
}

contains
object toilet_brush {
	noun: 'brush';
	adjective: 'toilet' 'loo';
	description: "A long-handled toilet brush, not particularly pleasant to handle but sturdy enough to clear a blocked pipe.";
}

location Hydroponic {
	description: "Long hydroponic trays run beneath banks of dead overhead grow-lights, the substrate dry and neglected after what must be weeks without tending. A small bonsai tree in the corner has held on better than the rest, its gnarled trunk evidently tougher than it looks.";
	n_to: Storeroom;
	e_to: Pantry;
	s_to: ToolRoom;
}

contains
object bonsai_tree {
	adjective: 'bonsai';
	noun: 'tree' 'wood';
    description: "A small but surprisingly dense bonsai tree, its gnarled trunk and compact branches ideal for reducing to charcoal with a good pounding.";
}

object charcoal {
	noun: charcoal;
	description: "It's a small amount of charcoal, perfect for absorbing toxic gases.";
}

location Pantry {
	description: "Shelving units hold an orderly supply of tinned goods and sealed containers, though several racks have been cleared at some point. A gas hose runs from a shutoff valve on the wall down to the oven, and a faint metallic smell hangs in the air.";
	w_to: Hydroponic;
	n_to: Kitchen;
}

contains
object hose {
	noun: 'hose';
}

location Gymnasium {
	description: [self] {
		if (PuzzleState &= HELMET_FREE and hand hasn't static)
			print_ret "A compact exercise room, weight racks still overturned, the treadmill on its side. The crewman's body remains pinned beneath the weight cage - helmetless, one hand severed at the wrist.";
		if (PuzzleState &= HELMET_FREE)
			print_ret "A compact exercise room, weight racks still overturned, the treadmill on its side. The crewman lies pinned beneath the weight cage, helmetless now.";
		print_ret "A compact exercise room that took the worst of the earthquake - weight racks overturned, a treadmill on its side, rubber matting buckled and torn. In the far corner a dead crewman lies pinned beneath a toppled cage of weights, still wearing his helmet.";
	}
	w_to: MainCorridor;
	s_to: MedicalBay;
}

contains object body {
	adjective: 'crew' 'dead';
	noun: 'body' 'crewman' 'man' 'corpse';
	description: [self] {
		if (PuzzleState &= HELMET_FREE and hand hasn't static)
			print_ret "The crewman lies pinned under the weight cage, helmetless and missing a hand. There is nothing more to take from him.";
		if (PuzzleState &= HELMET_FREE)
			print_ret "The crewman lies pinned under the weight cage, helmetless now. One hand remains - you could sever it if you need it for the biometric scanner.";
		print_ret "A dead crewman pinned under fallen gym equipment, still wearing his sealed helmet. The joints are seized with rust - something might free them up.";
	}
	before: [act] {
		if (act is #take)
			print_ret "The body is too heavy to move, and there is nothing to be gained by trying.";
		rfalse;
	}
	static;
}

contains
object helmet {
	noun: 'helmet';
	description: [self] {
		// TODO: use @jin here?
		if (PuzzleState &= CHARCOAL_IN_FILTER)
			print_ret "The helmet has a charcoal-packed coffee filter fitted - a crude but effective smoke mask.";
		if (PuzzleState &= FILTER_IN_HELMET)
			print_ret "The helmet has a coffee filter fitted into its breathing port. Pack it with charcoal to complete the mask.";
		if (PuzzleState &= HELMET_FREE)
			print_ret "A sealed helmet, freed from the body. Fit a filter to make it a smoke mask.";
		print_ret "A sealed helmet, seized up with rust on the dead crewman. It could be freed with WD40.";
	}
}

and
object hand {
	noun: 'hand';
	static;
}

routine CutWith [do ido] {
	if (ido isn't bread_knife)
		print_retf "You'll need something sharper than that!";
	if (do isn't hand)
		print_retf "You don't need to cut that.";
	if (hand hasn't static)
		print_retf "You... can't cut it again.";
	hand loses static;
	return ScoreMsg(5,"It's grisly work but you managed to separate the hand from the body.");
}

// This shows how to do a verb that can have a default indirect object. Define the full version first, because
// they are checked in order.
action #cut { 'sever'/'cut' NearbyWithHeld(bread_knife): CutWith }

// This shows how to make a command an alias for a different command.
routine RepairWith [do ido] { return PutOn(ido,do); }

action #repair { 'repair'/'fix' NearbyWithHeld(paperclip): RepairWith }

location Library {
	description: "Floor-to-ceiling shelves hold a mix of technical manuals and battered paperbacks, a handful of volumes knocked to the floor and left where they fell. One shelf along the far wall has come away from its fittings and hangs at an awkward angle.";
	s_to: Lounge;
}

contains object shelf_board {
	adjective: 'wooden';
	noun: 'shelf' 'board';
	description: "A solid wooden shelf that has come away from the wall, roughly a metre long. Sturdy enough to act as a ramp if leaned against something.";
}

location MedicalBay {
	description: "Banks of white-painted metal cabinets line the walls, most drawers hanging open and rifled through in evident haste. A single examination table sits beneath a surgical light that will never illuminate anything again.";
	n_to: Gymnasium;
}

contains object pestle {
	noun: 'pestle';
	description: "A heavy pestle, good for crushing things.";
}

routine CrushWith[do ido] {
	if (ido is crowbar)
		print_ret "That implement is better for prying than smashing.";
	else if (ido isn't pestle)
		print_ret "That's not really suitable to crush something with.";
	else if (do is hand)
		print_ret "Uh, you might need that intact for something later on.";
	else if (do isn't bonsai_tree)
		print_ret "Crushing that would serve no purpose.";
	else if (charcoal parent isn't zero)
		print_ret "You already have enough charcoal.";
	else {
		move charcoal into room;
		return ScoreMsg(3,"You crush up a bit of the bonsai tree into charcoal.");
	}
}

action #crushWith { 'crush'/'smash' Nearby 'with' Held: CrushWith }
action #crushWith { 'crush'/'smash' Nearby: [do] { rfalse if not DefaultWith(pestle); return CrushWith(do,IndirectObject); } }

location Lounge {
	description: "Sagging sofas and a pair of armchairs are arranged around a low table strewn with old magazines and the scattered pieces of several abandoned board games. A television set is bolted to the wall at head height, its screen long dark.";
	e_to: MainCorridor;
}

location WECorridor "East/West Corridor" {
	n_to: MainCorridor;
	sw_to: Workshop;
	s_to: ControlRoom;
	se_to: Generator;
}

location Reservoir {
	down_to: PumpRoom;
}

location ToolRoom {
	n_to: Hydroponic;
}

location Workshop {
	n_to: WECorridor;
	w_to: ToolRoom;
	e_to: ControlRoom;
}

location ControlRoom {
	w_to: Workshop;
	n_to: WECorridor;
	s_to: Armoury;
	e_to: Generator;
}

location Generator {
	w_to: ControlRoom;
	n_to: WECorridor;
	e_to: PumpRoom;
}

location PumpRoom {
	e_to: Generator;
	up_to: Reservoir;
}

location Armoury {
	n_to: ControlRoom;
}

global ifid = `UUID://2191F624-E980-46F6-B6F1-85792F494E81//`;

routine RunTasks[] {
	if (isnz light_stick.general) {
		--light_stick.general;
		if (iszero light_stick.general % 30)
			print "The light stick is a little dimmer than it was before.^";
	}
	rtrue;
}

routine main[] {
	LibraryInitialize();
	print "Bunker Blues, by Nate Taylor^";
	ReleaseInfo();
	Look();
	for (;;) {
		if (isnz DoTurn()) {
			++turns;
			RunTasks();
		}
	}
	quit;
}
