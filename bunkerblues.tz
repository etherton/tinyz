// This is special and sets the release number in the header (and is available as the constant as well)
constant ReleaseNumber = 1;

object Player "Player" in Airlock {
}

#include "core.tzh"

property object general;

location Airlock {
	description: "You are standing in a dimly lit airlock of a 
		fallout shelter. You hear the faint hum of the emergency 
		light, and an acrid smell from the fire you escaped lingers 
		in the air.^^As you look around the otherwise sterile room, 
		you notice a small control panel on the wall to your left, 
		next to the internal door.";
	s_to: MainCorridor;
	lit;
}

contains
object paperclip  {
	description: "The pinnacle of modern stationery, it holds 
		small piles of papers together.";
	noun: 'paperclip' 'clip';
	adjective: 'paper';
}

location Canteen {
	description: "The canteen.";
	e_to: MainCorridor;
	s_to: Kitchen;
	lit;
}

contains
object coffee_maker {
	noun: 'maker';
	adjective: 'coffee';
	description: [] {
		move coffee_filter into self parent;
		self.description = [] { print_ret "It's just an ordinary coffee maker, with nothing inside it."; };
		print_ret "It's just an ordinary coffee maker-- hey, wait, a coffee filter just fell out of it.";
	}
	before: [act] {
		if (act==#take) print_ret "It's fixed in place on the counter.";
		rfalse;
	}
}

object coffee_filter in Limbo {
	noun: 'filter';
	adjective: 'coffee';
}

location MainCorridor {
	description: "Fluorescent strips flicker overhead, casting a 
		sickly pallor over the metal-lined corridor running 
		the full length of the bunker. Rows of identical 
		painted-steel doors line each side, their stencilled 
		numbers faded to near-illegibility.";
	n_to: Airlock;
	s_to: WECorridor;
	sw_to: Lounge;
	w_to: Canteen;
	e_to: BunkRoom;
	lit;
}

contains
object light_stick  {
	description: [] {
		if (self hasn't lit)
			print_ret "It's a light stick. You can shake it to make it give off light.";
		else {
			print "It's a light stick, currently giving off ";
			if (self.general > 100)
				print_ret "quite a surprising bit of light.";
			else if (self.general > 30)
				print_ret "a good amount of light.";
			else
				print_ret "a rather feeble amount of light.";
		}
	}
	noun: 'stick' 'lightstick';
	adjective: 'light';
	after: [act] {
		if (act is #shake) {
			if (self has lit)
				print_ret "It's already lit!";
			else {
				self gains lit;
				self.general = 150;
				print_ret "It starts giving off a faint light.";
			}
		}
		rfalse;
	}
	general: 0;
}

action #shake { 'shake' Held: [do] { return CallAfter(#shake,do); } }

location BunkRoom {
	w_to: MainCorridor;
	e_to: Closet;
	s_to: Latrine;
	lit;
}

location Closet {
	w_to: BunkRoom;
}

contains 
object code_book {
	noun: 'codebook' 'book';
	adjective: 'code';
}

location Storeroom {
	description: "The storeroom.";
	e_to: Kitchen;
	s_to: Hydroponic;
}

contains
object crowbar {
	noun: 'crowbar';
}

location Kitchen {
	w_to: Storeroom;
	n_to: Canteen;
	s_to: Pantry;
}

contains
object bread_knife {
	noun: 'knife';
	adjective: 'bread';
}

location Latrine {
	n_to: BunkRoom;
}

contains
object toilet_brush {
	noun: 'brush';
	adjective: 'toilet' 'loo';
}

location Hydroponic {
	n_to: Storeroom;
	e_to: Pantry;
	s_to: ToolRoom;
}

contains
object bonsai_tree {
	noun: 'tree';
	adjective: 'bonsai';
}

location Pantry {
	w_to: Hydroponic;
	n_to: Kitchen;
}

contains
object hose {
	noun: 'hose';
}

location Gymnasium {
	w_to: MainCorridor;
	s_to: MedicalBay;
}

contains
object helmet {
	noun: 'helmet';
}

and
object hand {
	description: "I have no idea what this is.";
	noun: 'hand';
}

location Library {
	s_to: Lounge;
}

location MedicalBay {
	n_to: Gymnasium;
}

location Lounge {
	e_to: MainCorridor;
}

location WECorridor "East/West Corridor" {
	n_to: MainCorridor;
	sw_to: Workshop;
	s_to: ControlRoom;
	se_to: Generator;
}

location Reservoir {
	down_to: PumpRoom;
}

location ToolRoom {
	n_to: Hydroponic;
}

location Workshop {
	n_to: WECorridor;
	w_to: ToolRoom;
	e_to: ControlRoom;
}

location ControlRoom {
	w_to: Workshop;
	n_to: WECorridor;
	s_to: Armoury;
	e_to: Generator;
}

location Generator {
	w_to: ControlRoom;
	n_to: WECorridor;
	e_to: PumpRoom;
}

location PumpRoom {
	e_to: Generator;
	up_to: Reservoir;
}

location Armoury {
	n_to: ControlRoom;
}

global ifid = `UUID://2191F624-E980-46F6-B6F1-85792F494E81//`;

routine RunTasks[] {
	if (isnz light_stick.general) {
		--light_stick.general;
		if (iszero light_stick.general % 30)
			print "The light stick is a little dimmer than it was before.^";
	}
	rtrue;
}

routine main[] {
	room = Player parent;
	print "Bunker Blues, by Nate Taylor^";
	ReleaseInfo();
	Look();
	for (;;) {
		if (isnz DoTurn()) {
			++turns;
			RunTasks();
		}
	}
	quit;
}
