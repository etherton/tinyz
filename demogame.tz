// This is special and sets the release number in the header (and is available as the constant as well)
constant ReleaseNumber = 1;

object Player "Player" in Grotto {
}

#include "core.tzh"

location Grotto "Secluded Grotto" in Locations {
	description: "Nestled in the shade of the forest, this grotto is calm, quiet, and cooler than the rest of the area.";
	n_to: Riverbed;
	lit;
}

location Riverbed "Dry Riverbed" in Locations {
	description: "The river is dry here, and rocks and dead reeds litter the shoreline";
	n_to: Riverbed2;
	s_to: Grotto;
	w_to: Riverbank;
	lit;
}

location Riverbed2 "Dry Riverbed Bend" in Locations {
	description: "The river is dry here, but bends slowly to the northwest";
	s_to: Riverbed;
	lit;
}

location Riverbank "River Bank" in Locations {
	description: "Opposite bank of the dry river. Not much here but some thick bushes and an opening heading west.";
	w_to: Forest;
	e_to: Riverbed;
	lit;
}

location Forest "Dense Forest" in Locations {
	description: "The forest is very thick here. One tree in particular looks very robust and amenable to climing.";
	up_to: print "You clamber up the tree, getting pine needles everywhere.^",return Up_A_Tree;
	e_to: Riverbank;
	n_to: Clearing;
	lit;
}

location Clearing "Tranquil Clearing" in Locations {
	description: "The forest opens up a bit to a quiet clearing littered with pine needles. In the center is a strange altar.";
	s_to: Forest;
	lit;
}

object PrayerBook "Prayer Book" {
	description: "It's a magical prayer book. It says the magic word is ~foobar~.";
	noun: 'book';
	adjective: 'magical' 'prayer';
}

object Altar "Obsidian Altar" in Clearing {
	description: [self] {
		print "It is covered in strange runes and has a hidden shelf.^";
		if (iszero PrayerBook parent) {
			move PrayerBook into self parent;
			print_ret "Peering inside the opening, you find something!";
		}
		else
			rtrue;
	}
	noun: 'opening' 'altar';
	adjective: 'obsidian';
	scenery;
}


location Up_A_Tree "Up a Tree" in Locations {
	description: "You're up a tree. The view is incredible.";
	down_to: Forest;
	up_to: "Climbing any higher would be dangerous.";
	cant_go: "Letting go of the tree would be bad for your health.";
	lit;
}

global ifid = `UUID://42191F62-980E-46F6-B6F1-185792F494E8//`;

routine main[] {
	room = Player parent;
	print "DemoGame for TinyZ^";
	ReleaseInfo();
	Look();
	for (;;) {
		turns = turns + DoTurn();
	}
	quit;
}
