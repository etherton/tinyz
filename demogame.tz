#include "core.tzh"

object Player "Player" in Grotto {
}

// Parent for all locations
location Locations "Locations" {
}

location Grotto "Secluded Grotto" in Locations {
	n_to: Riverbed;
	lit;
}

location Riverbed "Dry Riverbed" in Locations {
	s_to: Grotto;
	lit;
}

routine main[] {
	room = Player parent;
	Look();
	repeat {
		turns = turns + DoTurn();
	} while (1==1);
	quit;
}
