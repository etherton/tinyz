// the file is parsed in two passes.
// the first pass processes all the global names (attributes,
// properties, objects, actions) and also extracts any dictionary
// words that appear in any property, action definition, or routine.

// Each resolves to an index between 1-31 (1-47 on v4+)
// attributes and properties can either be global (valid on both objects and locations)
// or specific to either objects or locations. It's not always strictly necessary but 
// reduces the chance of programming errors.
// attribute zero ($is_object) is special and is used to disambiguate objects (true) and locations (false)
attribute global lit;
attribute global general;
attribute object supporter;
attribute object clothing;
attribute object worn;
attribute object scenery;
attribute object vowel;

separators '.' ',' '"';

routine An [obj] {
	if (obj has vowel)
		print "An ",rfalse;
	else
		print "A ",rfalse;
}

routine an [obj] {
	if (obj has vowel)
		print "an ",rfalse;
	else
		print "a ",rfalse;
}

// the global constant $object_count is always the count
// of objects in the game. for properties that can refer
// to an object, string, or routine, values less than or
// equal to $object_count are an object. otherwise it's
// a routine. a string constant where a routine is allowed
// generates a dummy routine that calls print_ret and the string.
// (this costs two bytes, one for the local count and one
// for the print_ret opcode)

// words can refer to up to four dictionary words. a word is
// an index into a sorted list of vocabulary words. at most
// four words can be included on V3 games, which is why
// adjectives and nouns are kept separate.

constant false = 0;
constant zero = 0; 
constant true = 1;
constant adjectiveBit = 1 << 7;
constant nounBit = 1 << 6;
constant verbBit = 1 << 5;	// the compiler hard-codes this for actions
constant prepBit = 1 << 4;	// the compiler hard-codes this for actions
constant artBit = 1 << 3;
constant dirBit = 1 << 2;


// synonyms of a word are identical to it in all contexts. if a word appears
// here as a synonym it cannot appear anywhere else (because it would never match)
// internally synonyms are flagged with a payload of 0xFF. It's a table of words
// pointed to by the global variable $synonyms
synonym 'north' 'n';
synonym 'south' 's';
synonym 'east' 'e';
synonym 'west' 'w';
synonym 'examine' 'x' 'read';
synonym 'wait' 'z';
synonym 'inventory' 'i';
synonym 'again' 'g';
synonym 'look' 'l';

// plain properties can be attached to rooms or objects
// object properties can only be attached to objects
// room properties can only be attached to rooms
// object and room properties cannot be given nonzero default values
// because they actually overlap
property global description;
property global before;
property global after;
property object adjective wordbit adjectiveBit;
property object noun wordbit nounBit;
property location n_to;
property location s_to;
property location e_to;
property location w_to;

// set the specified bit in these words.
wordbit dirBit 'north' 'south' 'east' 'west';
wordbit artBit 'a' 'an' 'the';

// Map a word to a direction property or zero if no match.
// (property indices cannot be zero)
routine Compass [word] {
	if (word is 'north')
		return n_to;
	else if (word is 'south')
		return s_to;
	else if (word is 'east')
		return e_to;
	else if (word is 'west')
		return w_to;
	else
		rfalse;
}

// the first three must be in this order for status line (v3) games.
global room;
global score;
global turns;
global scratch;		// fourth global is used as a dummy storage slot for branches and subroutine calls that ignore result.
#if RELEASE 
constant $tracebits = 0;
#else
global $tracebits;	// this controls which trace statements display
#endif
global deadflag;

// player is always first at object 1. this also guarantees that
// a room a player can be in is always greater than 1, meaning routines
// that return a location can also rtrue or rfalse as well.
object Player "Player" (foyer) {
}

// This isn't strictly necessary but allows the Anywhere classifier
// to be implemented efficiently.
location Locations "The World" {
}

// If a string constant crosses multiple lines, any number of spaces and tabs
// followed by a line break is consumed. Next, N line breaks is turned into
// N-1 line breaks (usually zero) and then finally, one or more spaces and/or
// tabs (if present) becomes a single space. This is a very complicated way
// of saying you can break up a long string and it will end up looking reasonable.
// if you need to break up a line in the middle of a word, just start the remainder
// of the word at the leftmost column of the next line.
location foyer "Foyer of the Opera House" (Locations) { 
	description: 
		print_ret "You are standing in a spacious hall, splendidly decorated in red
		and gold, with glittering chandeliers overhead. The entrance from
		the street is to the north, and there are doorways south and west.";
	s_to: bar;
	n_to: print_ret "You've only just arrived, and besides, the weather outside seems
	    to be getting worse.";
	w_to: cloakroom;
	lit;
}

object Aardvark "aardvark" (foyer) {
	noun: 'aardvark';
	description: print_ret "It's here to test printing an object starting with a vowel.";
	vowel;
}

// location_or_object new_name "short description" ['(' parent ')'] '{'
// [property_or_attribute...] '}'
// property: property_name ':' value ';'
// attribute:
//	attribute_name ';'
// value: 
//   global_symbol
//   [dictionary_word]+
//   routine_defintion
// routine_definition: '[' [params..] [';' locals..] ']' '{' stmts '}'
location cloakroom "Cloakroom" (Locations) {
	description: print_ret "The walls of this small room were clearly once lined with hooks,
	 	though now only one remains. The exit is a door to the east.";
	e_to: foyer;
	lit;
}

object hook "small brass hook" (cloakroom) {
	adjective: 'small' 'brass';
	noun: 'hook' 'peg';
	description: [;c] {
		print "It's just a small brass hook, ";
		if (self has child -> c)
			print_ret "with ",an(c),object c," hanging on it.";
		else
			print_ret "screwed to the wall.";
	}
	scenery; supporter;
}

object hat "nondescript hat" (foyer) {
	adjective: 'boring' 'nondescript';
	noun: 'hat';
	description: print_ret "It's a really boring hat just meant to test the cloakroom";
	clothing;
}

object hat2 "fancy hat" (foyer) {
	adjective: 'fancy' 'handsome';
	noun: 'hat';
	description: print_ret "It's a fancy hat that also tests the cloakroom";
	clothing;
}

global message_damage;

location bar "Foyer Bar" (Locations) {
	description: print_ret "The bar, much rougher than you'd have guessed after the opulence
			of the foyer to the north, is completely empty. There seems to
			be some sort of message scrawled in the sawdust on the floor.";
	n_to: foyer;
	before: [act arg; temp] {
		if (act in {#look,#inv})
			rfalse;
		else if (act is #leave and arg is n_to)
			rfalse;
		else if (act is #leave and self hasnt lit and arg isnt n_to) {
			++message_damage;
			++message_damage;
			print_ret "Blundering around in the dark isn't a good idea!";
		}
		else if (self hasnt lit) {
			++message_damage;
			print_ret "In the dark? You could easily disturb something!";
		}
		else
			rfalse;
	}
}

object cloak "velvet cloak" (Player) {
	adjective: 'handsome' 'velvet' 'black' 'satin';
	noun: 'cloak';
	description: [] {
		print_ret "A ",bold,"handsome",normal," cloak, of velvet trimmed with satin, and slightly
			spattered with raindrops. Its ",italic,"blackness",normal," is so deep that it
			almost seems to suck light from the room.";
	}
	before: [act] {
		if (act in {#drop,#puton} and room isnt cloakroom)
			print_ret "This isn't the best place to leave
				a smart cloak lying around.";
		rfalse; // not handled, allow action to continue
	}
	after: [act] {
		if (act is #take)
			bar loses lit;
		else if (act in {#puton,#drop} and room is cloakroom) {
			bar gains lit;
			if (act is #puton and self has general) {
				self loses general;
				++score;
			}
		}
		rfalse;
	}
	clothing; general; worn;
}

object message "scrawled message" (bar) {
	adjective: 'scrawled';
	noun: 'message' 'sawdust' 'floor';
	description: []{
		if (message_damage < 2) {
			++score;
			deadflag = 2;
			print_ret "The message, neatly marked in the sawdust, reads...";
		}
		else {
			deadflag = 3;
			print_ret "The message has been carelessly trampled, making it
			  difficult to read. You can just distinguish the words...";
		}
	}
}

//////////////////// LIBRARY CODE /////////////////////

// there are several ways to declare dictionary words. the syntax always
// uses single quotes. the context determines which bits are set on the word
// to identify default parts of speech
// dir_bit, adj_bit, noun_bit, verb_bit
// directions are also adjectives in most cases


routine perform [act obj iobj] {
	act = act;
	rfalse;
}

// General actions should return true if they worked, and false if they failed.
// Failed actions don't cost a game turn.
routine Inventory [;i] {
	if (Player has child -> i) {
		print "You are carrying:";
		crlf;
		repeat {
			print "  ";
			print_obj i;
			crlf;
		} while (i has sibling -> i);
		rtrue;
	}
	else
		print_ret "You are empty-handed.";
}

// The before routine should return true if the action is blocked (and explain why).
// Otherwise it should return false to allow the action. Other side effects should not
// happen because the action isn't guaranteed to succeed yet. CallAfter should handle that.
routine BlockBefore [act obj arg;r] {
	if (isz obj)
		rfalse;
	r = obj.before;
	if (isnz r)
		return call r(act,arg);
	else
		rfalse;
}

// This calls the after function, after an action has already succeeded. The return
// value is currently unimportant.
routine CallAfter [act obj;r] {
	if (isnz obj) {
		r = obj.after;
		if (isnz r)
			return call r(act,obj);	
	}
	rtrue;
}

routine Look [; i r f] {
	if (room hasn't lit)
		print_ret "It's too dark to see anything.";
	r = call room.description();
	if (room has child -> i) {
		repeat {
			if (i isn't Player and i has $is_object and i hasn't scenery) {
				if (once f)
					print "You can also see:^";
				print An(i),object i,crlf;
			}
		} while (i has sibling -> i);
	}
	return r;
}

routine Travel [dir;r] {
	if (isfalse BlockBefore(#leave,room,dir)) {
		r = room.dir;
		if (isz r)
			print_retf "You can't go in that direction.";
		else if (r < zero or r > $object_count)
			r = call r();
		// player is the first object, and cannot be a room.
		// this leave rfalse and rtrue as valid responses.
		if (r > 1) {
			move Player into r;
			room = r;
			CallAfter(#enter,r);
			Look();
			rtrue;
		}
	}
	rfalse;
}

routine Take [obj] {
	trace 1 "Take called on ",object obj,"^";
	if (obj parent is Player)
		print_ret "You're already carrying it.";
	else if (obj has scenery)
		print_retf "You can't take that, it's just scenery.";
	if (istruth BlockBefore(#take,room))
		rfalse;
	if (istruth BlockBefore(#take,obj))
		rfalse;
	move obj into Player;
	CallAfter(#take,obj);
	print_ret "You pick up the ",object obj,".";
}

routine Examine [obj; desc] {
	if (room hasn't lit)
		print_retf "It's too dark to see anything.";
	desc = obj.description;
	if (isnz desc)
		return call desc();
	else
		print_ret "It's just an ordinary ",object obj,".";
}

routine Drop [obj] {
	// print "Dropping "; print_num obj; crlf;
	// print_num obj parent; crlf;
	if (Player holds obj) {
		if (istruth BlockBefore(#drop,room))
			rfalse;
		if (istruth BlockBefore(#drop,obj))
			rfalse;
		move obj into Player parent;
		print_ret "You drop the ",object obj,".";
	}
	else
		print_retf "You're not carrying that.";
}

routine PutOn [do ido] {
	// print "PutOn!^"; print_num do; crlf; print_num ido; crlf;
	if (ido has supporter) {
		if (ido has child)
			print_retf "There's no room.";
		if (do hasn't clothing)
			print_retf "It's only meant to hold clothing.";
		if (istruth BlockBefore(#puton,room))
			rfalse;
		if (istruth BlockBefore(#puton,do))
			rfalse;
		if (istruth BlockBefore(#puton,ido))
			rfalse;

		move do into ido;
		CallAfter(#puton,ido);
		CallAfter(#puton,do);
		CallAfter(#puton,room);
		print_ret "You place the ",object do," on the ",object ido,".";
	}
	else
		print_retf "You can't put the ",object do," on the ",object ido,".";
}

// The action table starts with the action routine, or -1 to terminate the entire list.
// After that, one or more words follow with the bits below set:
// isEnd, isRoutine, and hasSecondWord are hard-coded into the compiler.
// Some code tests < 0 instead of checking isEnd explicitly.
constant isEnd = 1 << 15;			// This is the last part of the action
constant isRoutine = 1 << 14;		// Routine (possibly after second word) marks end of phrase
constant hasSecondWord = 1 << 13;	// This is a two word phrase, not a one word phrase.
// constant wordMask = 8191;
global wordMask = 8191;		// declaring as a global allows it to use smaller instructions

// going into tokenization, [0] is number of words we can store, on return [1]
// is the number of words stored. [[1]], [[3]], etc are the word addresses of
// the ditionary matches, or 0 if unknown. [4]/[5], [8]/[9] etc are the offset
// into text_buffer of the word, and its length. after our processing, [[0]]
// is the number of words, [[1]],[[3]], etc are the word indices (unknown words
// will have caused an error by now), and [[2]],[[4]] are the dict word flags.
global parse_buffer = byte_array(64);
global nw;	// next word being processed (always an odd number)
global lw;	// last word index (so we know we're at end of input)
global na;	// next action being processed

// These all control RecurseMatch functionality.
// They're globals to get around v3 parameter count limitations and to save stack space.
constant MaxObjectList = 8;
global ObjectList = word_array(MaxObjectList);
global ObjectListCount;
global ExcludeObject;
global MatchProp;
global MatchWord;
global it;			// the last direct object

routine MatchPropertyWord [match obj prop; j k] {
	k = addrof(obj.prop);
	if (isnz k) {
		while (j+j < sizeof(k)) {
			if (match is k[[j]])
				rtrue;
			++j;
		}
	}
	rfalse;
}

routine RecurseMatch [obj; j k] {
	if (obj has child -> obj) {
		repeat {
			// print_num obj; print_char @ ; print_obj obj; crlf;
			if (obj isn't ExcludeObject) {
				if (obj has $is_object) {
					if (istruth MatchPropertyWord(MatchWord,obj,MatchProp)) {
						trace 1 "adding ",object obj,crlf;
						if (ObjectListCount < MaxObjectList)
							ObjectList[[ObjectListCount]] = obj;
						++ObjectListCount;
					}
				}
				RecurseMatch(obj);
			}
		} while (obj has sibling -> obj);
	}
	rfalse;
}

routine PrintDict [w; hdr] {
	w = hdr[[4]] + 7 + w * ($dict_entry_size+1);
	print_addr w;
	rfalse;
}

routine ParseCommon [root; i adj] {
	if (parse_buffer[[nw+1]] &= artBit)
		nw = nw + 2;
	if (parse_buffer[[nw]] is 'it' and it isn't zero) {
		nw = nw + 2;
		return it;
	}
	if (parse_buffer[[nw+1]] &= adjectiveBit) {
		adj = parse_buffer[[nw]];
		nw = nw + 2;
	}
	if (parse_buffer[[nw+1]] &= nounBit) {
		ObjectListCount = 0;
		MatchProp = noun;
		MatchWord = parse_buffer[[nw]];
		RecurseMatch(root);
		if (ObjectListCount > 1) {
			if (isnonzero adj) {
				i = 0;
				while (i < ObjectListCount) {
					if (istruth MatchPropertyWord(adj,ObjectList[[i]],adjective)) {
						nw = nw + 2;
						return ObjectList[[i]];
					}
					++i;
				}
			}
			print "I'm not sure which one you meant: ";
			while (i < ObjectListCount - 1) {
				print "the ",object ObjectList[[i]],", ";
				++i;
			}
			print "or the ",object ObjectList[[i]],"?^";
			rfalse;
		}
		if (ObjectListCount is 1) {
			nw = nw + 2;
			return ObjectList[[0]];
		}
		else
			rfalse;
	}
	else
		rfalse;
}

// Parse a word that is here but not held
routine Here [] {
	// print "Testing Here.^";
	ExcludeObject = Player;
	return ParseCommon(Player parent);
}

// Parse a word that is held
routine Held [] {
	// print "Testing Held.^";
	ExcludeObject = 0;
	return ParseCommon(Player);
}

// Parse a word here or held
routine Nearby [] {
	// print "Testing Nearby.^";
	ExcludeObject = 0;
	return ParseCommon(Player parent);
}

// Parse a word anywhere in the world
routine Anywhere [] {
	ExcludeObject = 0;
	return ParseCommon(Locations);
}

// Parse a word that is a compass direction
routine Direction [] {
	if (parse_buffer[[nw+1]] &= artBit)
		nw = nw + 2;
	return Compass(parse_buffer[[nw]]);
}

routine Yes [] {
	print "Are you sure? [y/N]^";
#if $v5
	text_buffer[1] = 0;
	sread(text_buffer, 0);
	if (text_buffer[2] in {@Y,@y})
		rtrue;
#else
	sread(text_buffer, parse_buffer);
	if (text_buffer[1] in {@Y,@y})
		rtrue;
#endif
	print_retf "Canceled.";
}

routine Restart[] { if (istruth Yes()) restart; rfalse; }
routine Quit[] { if (istruth Yes()) quit; rfalse; }

// actions are scanned in-order
// so specific cases need to be before more general cases
// some actions are really just messages and aren't part of grammar
action #inv { 'inventory'/'take inventory': Inventory }
action #take { 'get'/'take'/'pick up' Here: Take }
action #drop { 'drop'/'put down' Held: Drop }
action #look { 'look at'/'examine' Nearby: Examine }
action #lookHere { 'look': Look }
action #puton { 'hang'/'place'/'put' Held 'on'/'upon'/'on to'/'onto' Here: PutOn }
action #go { 'go'/'go to' Direction: Travel }
action #restart { 'restart'/'restart game': [] { if (istruth Yes()) restart; rfalse; } }
action #quit { 'quit'/'quit game': [] { if (istruth Yes()) quit; rfalse; } }
#if not RELEASE
action #traceOn { '#trace on' : [] { $tracebits = 1; rfalse; } }
action #traceOff { '#trace off' : [] { $tracebits = 0; rfalse; }}
#endif
action #leave;
action #enter;

global text_buffer = byte_array(64) { 63 };

routine PrintString [str len] {
	// for v3/4, string is terminated by zero
	// for v5, the new length is supplied in second byte of buffer
	while (len isnt zero and str[0] isnt zero) {
		print_char str[0];
		++str;
		--len;
	}
	rfalse;
}

routine DictAddrToIndex [addr; hdr] {
	addr = addr - hdr[[4]] - 7;
	addr = addr / ($dict_entry_size+1);
	return addr;
}

// given address of a word that is a synonym, return address of original word
// on v4+ the count is stored first so we can use scan_table.
// on v3, the list is terminated by -1
routine FindSynonym [wordAddr; c i m hdr] {
#if $v4
	// scans entire table for word match. The base words have the MSB set
	// so they will never match.
	if (scan_table(wordAddr[[0]],$synonyms + 2,$synonyms[[0]]) -> i) {
		repeat { i = i - 2; } while (i[[0]]>=0);
		m = i[[0]] & wordMask;
		wordAddr[[0]] = m;
		m = m * ($dict_entry_size+1) + 7 + hdr[[4]];
		wordAddr[[1]] = m[$dict_entry_size];
		rtrue;
	}
#else
	while ($synonyms[[i]] isn't -1) {
		if ($synonyms[[i]] < 0)
			m = $synonyms[[i]] & wordMask;
		else if ($synonyms[[i]] is wordAddr[[0]]) {
			wordAddr[[0]] = m;
			m = m * ($dict_entry_size+1) + 7 + hdr[[4]];
			wordAddr[[1]] = m[$dict_entry_size];
			rtrue;
		}
		++i;
	}
#endif
	rfalse;
}

routine CheckErrors [tb pb; i j] {
	/* print_num tb[0]; print_char 32;
	print_num tb[1]; print_char 32;
	print_num tb[2]; print_char 32;
	print "[[";
#if $v5
	PrintString(tb+2,tb[1]);
#else
	PrintString(tb+1,tb[0]);
#endif
	else
	print "]]^"; */

	// check number of words parsed
	if (pb[1] is zero) 
		print_ret "I beg your pardon?";
	i = 0;

	// print_num pb[1]; print " words in input.^";
	// print_num pb; print " base addr.^";

	while (i < pb[1]) {
		j = pb + 2 + i * 4;
		// print_num j; crlf;
		// print_num j[[0]]; print " addr.^";
		if (j[[0]] is zero)
			print_ret "I don't understand the word '",PrintString(tb + j[3], j[2]),"'.";
		else {
			// Copy the type byte over
			j[[1]] = j[[0]][$dict_entry_size];
			// Replace the address with the index
			j[[0]] = DictAddrToIndex(j[[0]]);
			// Deal with synonyms (and fix type byte)
			if (j[[1]]==255)
				FindSynonym(j);
		}
		++i;
	}
	rfalse;
}



routine ObjLoop[;i j k w] {
	while (i < $object_count) {
		++i;
		print An(i),object i,crlf;
		if (i has $is_object) {
			j = addrof(i.adjective);
			if (j isnt 0) {
				print " has adjectives:";
				k = 0;
				while (k+k < sizeof(j)) {
					print_char 32;
					PrintDict(j[[k]]);
					++k;
				}
			}
			j = addrof(i.noun);
			if (j isnt 0) {
				print " and has nouns:";
				k = 0;
				while (k+k < sizeof(j)) {
					print_char 32;
					PrintDict(j[[k]]);
					++k;
				}
			}
		}
		else
			print " is a location";
		crlf;
	}
	rfalse;
}

global ActionRoutine;
global DirectObject;
global IndirectObject;

routine ScanParseTable [; n matched] {
	na = 0;
	DirectObject = 0;
	IndirectObject = 0;
	while ($actions[[na]] isn't -1) {
		nw = 1;
		matched = 0;
		repeat {
			trace 1 "Starting phrase.^";
			repeat {
				n = $actions[[na]];
				++na;
				trace 1 "n = ",n,crlf;
				// PrintDict(n & wordMask); crlf;
				if (n &= hasSecondWord) {
					if (n & wordMask is parse_buffer[[nw]] and $actions[[na]] & wordMask is parse_buffer[[nw+2]])
						matched = 2;
					n = $actions[[na]];
					++na;
				}
				else {
					if (n & wordMask is parse_buffer[[nw]])
						matched = 1;
				}
				trace 1 "matched = ",matched,crlf;
				if (n &= isRoutine) {
					trace 1 "found routine^";
					if (matched isn't 0) {
						nw = nw + matched + matched;
						matched = $actions[[na]];
						if (DirectObject isn't zero) {
							IndirectObject = call matched();
							if (isfalse IndirectObject)
								rfalse;
							trace 1 "IndirectObject now ",IndirectObject,crlf;
						}
						else {
							DirectObject = call matched();
							if (isfalse DirectObject)
								rfalse;
							trace 1 "DirectObject now ",DirectObject,crlf;
						}
					}
					++na;
				}
			} while (n & (isRoutine | isEnd) is 0);
			if (n &= isEnd) {
				ActionRoutine = $actions[[na]];
				++na;
				if (istruth matched)
					rtrue;
			}
			matched = 0;
		} while (n >= 0);
	}
	print "I didn't understand that.^";
	rfalse;
}

routine DoTurn[; i] {
	text_buffer[0] = 62;
	parse_buffer[0] = 14; // includes room for "zero" terminator

	// text_buffer[0] is the size of the input buffer
	// in v5+, text_buffer[1] is the number of bytes actually read
	// parse_buffer[0] is the max number of words
	// parse_buffer[1] is the actual number of words parsed
	// each word consists of four bytes:
	// first two bytes is address of the word, or 0 if unknown
	// next byte is the length of the word, then the position in text_buffer.
	repeat {
#if $v5
		text_buffer[1] = 0;
#endif
		sread(text_buffer, parse_buffer);
	} while (CheckErrors(text_buffer, parse_buffer) isnt zero);

	// parse_buffer[1] is the actual number of words parsed
	// parse_buffer[[1]] is the first word parsed (same as parse_buffer[2] and [3])
	// parse_buffer[[2]] is the type code of the first word

	// Every word address in the parse buffer has been replaced with its index.
	// The next byte contains the payload byte.
	if (parse_buffer[[2]] &= dirBit) {
		i = Compass(parse_buffer[[1]]);
		if (i isnt 0)
			return Travel(i);
	}
	// compute final word index, terminate list with zero
	lw = parse_buffer[1] * 2 + 1;
	parse_buffer[[lw]] = 0;		// set word index to zero
	parse_buffer[[lw+1]] = 0;	// no type bits set
	if (ScanParseTable(parse_buffer[1],parse_buffer + 2) isn't zero) {
		// print "DirectObject = "; print_num DirectObject; crlf;
		// print "IndirectObject = "; print_num IndirectObject; crlf;
		if (DirectObject isn't zero)
			it = DirectObject;
		return call ActionRoutine(DirectObject, IndirectObject);
	}

	rfalse;
}

routine DebugActions[;a n] {
	while ($actions[[a]] isnt -1) {
		repeat {
			n = $actions[[a]];
			++a;
			PrintDict(n & wordMask);
			if (n &= hasSecondWord)
				print "+";
			else
				print " ";
			if (n &= isRoutine) {
				print "(routine ",$actions[[a]],") ";
				++a;
			}
		} while (n > 0);
		print ": routine ",$actions[[a]],crlf;
		++a;
	}
	rfalse;
}

routine Startup[; hdr] {
   room = Player parent;

   print "Release ",hdr[[1]]," compiled on ",PrintString(18,6)," by tinyzc v",PrintString(60,4),"^";

   print_ret "^Hurrying through the rainswept November night, you're glad to see the
	bright lights of the Opera House. It's surprising that there aren't more
	people about but, hey, what do you expect in a cheap demo game...?^";
}

routine main [] {
	Startup();
	Look();
	// ObjLoop();
	// DebugActions();
	while (deadflag is zero) {
		turns = turns + DoTurn();
		if (deadflag is 3)
			print "*** You have lost! ***^";
		else if (deadflag is 2)
			print "*** You have won! ***^";
	}
	print "Your final score was ",score," in ",turns," turns.^";
	quit;
}
